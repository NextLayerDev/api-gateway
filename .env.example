PORT=8080
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
UPVOX_UPSTREAM=http://localhost:3000
LASER_UPSTREAM=http://localhost:3333
# Segredo compartilhado com a upvox-api (mesmo valor de GATEWAY_SHARED_SECRET lá).
# Sem ele a API ignora os x-user-* e resolve a identidade pelo Bearer.
GATEWAY_SHARED_SECRET=
# Opcional: JWT secret do Supabase (Settings › API › JWT Settings). Com ele o
# token HS256 é verificado localmente (jose), sem ida ao auth a cada token novo.
# Vazio (ou token ES256/RS256 de chave assimétrica) = continua o auth.getUser.
SUPABASE_JWT_SECRET=
# Origens liberadas no CORS, separadas por vírgula (vazio = reflete qualquer origem).
CORS_ORIGINS=https://seu-front.exemplo.com
